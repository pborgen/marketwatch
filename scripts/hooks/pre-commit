#!/usr/bin/env bash
# Validate Terraform when a commit stages infra config.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

staged="$(git diff --cached --name-only)"
if ! grep -Eq '^(infra/.*\.(tf|tfvars)|infra/.*\.terraform\.lock\.hcl)$' <<<"$staged"; then
  exit 0
fi

bash "$ROOT/scripts/terraform/validate.sh"
